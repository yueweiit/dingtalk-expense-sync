# ============================================================
# Environment Variables Configuration
# ============================================================
# Copy this file to .env and fill in the values
# Required variables MUST be set for the application to start
# Optional variables have default values from config.json

# ============================================================
# REQUIRED - Database Configuration
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dingtalk_approval
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# ============================================================
# REQUIRED - DingTalk API Credentials
# ============================================================
DINGTALK_APPKEY=your_dingtalk_appkey_here
DINGTALK_APPSECRET=your_dingtalk_appsecret_here

# ============================================================
# OPTIONAL - DingTalk Business Configuration
# ============================================================
# Cashier activity IDs (JSON array format)
# DINGTALK_CASHIER_ACTIVITY_IDS=["1793_35c3"]

# Cashier activity IDs by process code (JSON object format)
# DINGTALK_CASHIER_ACTIVITY_IDS_BY_PROCESS_CODE={}

# Process codes (JSON array format)
# DINGTALK_PROCESS_CODES=["PROC-0DC5DE17-A29A-497C-8A1F-1324298A04AA","PROC-BFDF6F09-4551-43B3-8C55-537AA74A241B"]

# ============================================================
# OPTIONAL - Scheduler Configuration
# ============================================================
# Cron expression for incremental sync (default: 7 * * * *)
# SCHEDULER_CRON=7 * * * *

# Start time for initial sync (ISO 8601 format, default: 2026-04-01T00:00:00+08:00)
# SCHEDULER_START_TIME=2026-04-01T00:00:00+08:00

# Cron expression for compensation task (default: 17 3 * * *)
# SCHEDULER_COMPENSATION_CRON=17 3 * * *

# Cron expression for FX rates sync (default: 5 0 * * *)
# SCHEDULER_FX_RATES_CRON=5 0 * * *

# Timezone for FX rates (default: Asia/Shanghai)
# SCHEDULER_FX_RATES_TIMEZONE=Asia/Shanghai

# Run FX rates sync on startup (true/false, default: true)
# SCHEDULER_FX_RATES_RUN_ON_STARTUP=true

# Limit for pending compensation records (default: 500)
# SCHEDULER_PENDING_COMPENSATION_LIMIT=500

# Limit for stale agreed refresh records (default: 80)
# SCHEDULER_STALE_AGREED_REFRESH_LIMIT=80

# ============================================================
# OPTIONAL - Server Configuration
# ============================================================
# Server port (default: 3002)
# PORT=3002
