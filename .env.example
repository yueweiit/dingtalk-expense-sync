# ============================================================
# Environment Variables Configuration
# ============================================================
# Copy this file to .env and fill in the values
# Required variables MUST be set for the application to start
# Optional variables have default values from config.json

# ============================================================
# REQUIRED - Database Configuration
# ============================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dingtalk_approval
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# ============================================================
# REQUIRED - DingTalk API Credentials
# ============================================================
DINGTALK_APPKEY=your_dingtalk_appkey_here
DINGTALK_APPSECRET=your_dingtalk_appsecret_here

# ============================================================
# OPTIONAL - DingTalk Business Configuration
# ============================================================
# Process codes (JSON array format)
# DINGTALK_PROCESS_CODES=["PROC-0DC5DE17-A29A-497C-8A1F-1324298A04AA","PROC-BFDF6F09-4551-43B3-8C55-537AA74A241B"]
# Explicit process type mapping (JSON object format)
# DINGTALK_PROCESS_TYPE_MAP={"operation":["PROC-0DC5DE17-A29A-497C-8A1F-1324298A04AA","PROC-618F58F6-A68C-4BFE-A92B-49B3CD9B79DD"],"purchase":["PROC-BFDF6F09-4551-43B3-8C55-537AA74A241B"]}

# ============================================================
# OPTIONAL - Scheduler Configuration
# ============================================================
# Cron expression for incremental sync (default: 7 * * * *)
# SCHEDULER_CRON=7 * * * *

# Start time for initial sync (ISO 8601 format, default: 2026-04-01T00:00:00+08:00)
# SCHEDULER_START_TIME=2026-04-01T00:00:00+08:00

# Cron expression for compensation task (default: 17 3 * * *)
# SCHEDULER_COMPENSATION_CRON=17 3 * * *

# Cron expression for FX rates sync (default: 5 0 * * *)
# SCHEDULER_FX_RATES_CRON=5 0 * * *

# Timezone for FX rates (default: Asia/Shanghai)
# SCHEDULER_FX_RATES_TIMEZONE=Asia/Shanghai

# Run FX rates sync on startup (true/false, default: true)
# SCHEDULER_FX_RATES_RUN_ON_STARTUP=true

# Limit for pending compensation records (default: 500)
# SCHEDULER_PENDING_COMPENSATION_LIMIT=500

# Limit for stale agreed refresh records (default: 80)
# SCHEDULER_STALE_AGREED_REFRESH_LIMIT=80

# ============================================================
# OPTIONAL - Server Configuration
# ============================================================
# Server port (default: 3002)
# PORT=3002

# ============================================================
# OPTIONAL - DingTalk Robot Configuration
# ============================================================
# Robot code for sending messages (separate from appkey/appsecret)
# DINGTALK_ROBOT_CODE=your_robot_code_here

# Robot app credentials (separate app from expense sync, needs qyapi_robot_sendmsg permission)
# DINGTALK_ROBOT_APPKEY=your_robot_appkey_here
# DINGTALK_ROBOT_APPSECRET=your_robot_appsecret_here

# ============================================================
# OPTIONAL - Weekly Report Configuration
# ============================================================
# Enable weekly budget report (true/false, default: false)
# SCHEDULER_WEEKLY_REPORT_ENABLED=false

# Cron expression for weekly report (default: 0 10 * * 1 = Monday 10:00 AM)
# SCHEDULER_WEEKLY_REPORT_CRON=0 10 * * 1

# Timezone for weekly report (default: Asia/Shanghai)
# SCHEDULER_WEEKLY_REPORT_TIMEZONE=Asia/Shanghai

# Dry-run mode: log report content without sending (true/false, default: false)
# SCHEDULER_WEEKLY_REPORT_DRY_RUN=false

# Admin userId for summary notification after report sending
# SCHEDULER_WEEKLY_REPORT_ADMIN_USER_ID=

# Department recipients mapping (JSON format: deptName -> userId array)
# Departments not configured will be skipped
# SCHEDULER_WEEKLY_REPORT_DEPT_RECIPIENTS={"YW Tech_Ai":["userId1"],"AG 核算小组":["userId2","userId3"]}

# Secret for manual trigger endpoint (required in production)
# REPORT_SECRET=your_report_secret_here
